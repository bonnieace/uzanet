# Use the origin only or the complete /api/v1 base; both forms are accepted.
VITE_API_BASE_URL=http://localhost:8000

# Optional only when retaining the legacy /login portal URL without /portal/:portalSlug.
VITE_DEFAULT_PORTAL_SLUG=

# Comma-separated public hotspot hosts allowed to receive ticket login credentials.
# Private RFC1918 IPs and .local/.lan hosts are trusted automatically.
VITE_ALLOWED_HOTSPOT_HOSTS=
